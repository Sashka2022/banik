{
  "name": "Task",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "\u05db\u05d5\u05ea\u05e8\u05ea"
    },
    "area_id": {
      "type": "string",
      "title": "\u05ea\u05d7\u05d5\u05dd \u05e2\u05e9\u05d9\u05d9\u05d4"
    },
    "due_date": {
      "type": "string",
      "title": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d9\u05e2\u05d3"
    },
    "priority": {
      "type": "string",
      "title": "\u05e2\u05d3\u05d9\u05e4\u05d5\u05ea",
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "default": "medium"
    },
    "progress": {
      "type": "number",
      "title": "\u05d4\u05ea\u05e7\u05d3\u05de\u05d5\u05ea",
      "default": 0
    },
    "is_completed": {
      "type": "boolean",
      "title": "\u05d4\u05d5\u05e9\u05dc\u05dd",
      "default": false
    },
    "subtasks": {
      "type": "array",
      "title": "\u05ea\u05ea\u05d9 \u05de\u05e9\u05d9\u05de\u05d5\u05ea",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "estimated_hours": {
      "type": "number",
      "title": "\u05d6\u05de\u05df \u05de\u05e9\u05d5\u05e2\u05e8 (\u05e9\u05e2\u05d5\u05ea)"
    },
    "calendar_event_id": {
      "type": "string",
      "title": "\u05de\u05d6\u05d4\u05d4 \u05d0\u05d9\u05e8\u05d5\u05e2 \u05d9\u05d5\u05de\u05df"
    },
    "doc_url": {
      "type": "string",
      "title": "\u05e7\u05d9\u05e9\u05d5\u05e8 \u05dc\u05de\u05e1\u05de\u05da Google"
    }
  },
  "required": [
    "title",
    "area_id",
    "priority"
  ]
}